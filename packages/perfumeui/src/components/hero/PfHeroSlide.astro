---
/**
 * One hero of the home carousel. Same layout as the Fluxenture guide hero
 * (ui/StaticHero): a full-bleed stage with the text over it on desktop, and
 * the text below it on a white panel on mobile. The stage holds whatever goes
 * in the `visual` slot (an HTML scene today; a rendered image later).
 */
import "../../styles/hero-scene.css";
import type { CtaLink } from "../types";
import PfHeroTextContent from "../ui/PfHeroTextContent.astro";

interface Props {
  badge?: string;
  title: string;
  body?: string;
  cta?: CtaLink;
  secondaryCta?: CtaLink;
  /** Only the first slide of the page should be 1. */
  headingLevel?: 1 | 2;
  /** Stage wash. All three stay in the same blue family. */
  stage?: "blue" | "periwinkle" | "sky";
}

const { stage = "blue", ...text } = Astro.props;
---

<div class:list={["hero-slide", `hero-slide--${stage}`]}>
  <div class="hero-slide__stage">
    <div class="hero-slide__visual" aria-hidden="true">
      <slot name="visual" />
    </div>

    <div class="hero-slide__desktop container">
      <PfHeroTextContent {...text} tone="dark" />
    </div>
  </div>

  <div class="hero-slide__mobile container">
    <PfHeroTextContent {...text} tone="dark" />
  </div>
</div>

<style>
  /* With a fixed height (e.g. inside HeroCarousel) the stage absorbs the
     difference; otherwise it keeps its own height. */
  .hero-slide {
    display: flex;
    flex-direction: column;
  }

  .hero-slide__stage {
    position: relative;
    overflow: hidden;
    height: 320px;
    flex: 1 1 auto;
    min-height: 0;
  }

  .hero-slide--blue .hero-slide__stage {
    background:
      radial-gradient(60% 80% at 78% 40%, rgba(255, 255, 255, 0.55), transparent 70%),
      linear-gradient(100deg, #f4f8ff 0%, #dde8ff 45%, #b8ccfa 100%);
  }

  .hero-slide--periwinkle .hero-slide__stage {
    background:
      radial-gradient(60% 80% at 75% 45%, rgba(255, 255, 255, 0.5), transparent 70%),
      linear-gradient(100deg, #f6f6ff 0%, #e2e2fd 45%, #c3c4f6 100%);
  }

  .hero-slide--sky .hero-slide__stage {
    background:
      radial-gradient(60% 80% at 75% 45%, rgba(255, 255, 255, 0.55), transparent 70%),
      linear-gradient(100deg, #f3fafe 0%, #d9eefb 45%, #b0d6f3 100%);
  }

  .hero-slide__visual {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .hero-slide__desktop {
    display: none;
  }

  .hero-slide__mobile {
    padding-top: var(--space-6);
  }

  @media (min-width: 1085px) {
    .hero-slide__stage {
      height: clamp(540px, 40vw, 640px);
      display: flex;
      align-items: center;
    }

    .hero-slide__visual {
      left: auto;
      right: 3%;
      width: min(50%, 780px);
    }

    .hero-slide__desktop {
      display: block;
      position: relative;
      z-index: 2;
    }

    .hero-slide__mobile {
      display: none;
    }
  }
</style>
