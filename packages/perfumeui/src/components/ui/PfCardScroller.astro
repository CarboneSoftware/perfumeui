---
/**
 * Carril horizontal de cards con snap y flechas.
 * Las cards llegan por slot; el scroller solo aporta el layout y el control.
 */
import { ChevronRight, ChevronLeft } from "@lucide/astro";
import type { CtaLink } from "../types";
import PfSectionHeading from "./PfSectionHeading.astro";

interface Props {
  title?: string;
  kicker?: string;
  link?: CtaLink;
  /**
   * Bucle infinito: el carril clona la tira de cards y envuelve el scroll,
   * así nunca se llega a un extremo. Desactiva el snap (ver nota en el script).
   */
  infinite?: boolean;
}

const { title, kicker, link, infinite = false } = Astro.props;
---

<section
  class:list={["scroller", { "scroller--infinite": infinite }]}
  data-infinite={infinite ? "true" : "false"}
>
  {
    title && (
      <div class="scroller__head">
        <PfSectionHeading
          title={title}
          kicker={kicker}
          link={link}
          size="md"
          gap="sm"
        />
      </div>
    )
  }

  <div class="scroller__track" role="list">
    <slot />
  </div>

  <div class="scroller__controls">
    <button
      type="button"
      class="scroller__arrow scroller__arrow--prev"
      aria-label="Anterior"
    >
      <ChevronLeft />
    </button>
    <button
      type="button"
      class="scroller__arrow scroller__arrow--next"
      aria-label="Siguiente"
    >
      <ChevronRight />
    </button>
  </div>
</section>

<script>
  // Solver de cubic-bezier (mismo método que usa CSS para su timing function).
  // Devuelve una función ease(t) con t y resultado en [0, 1].
  function cubicBezier(p1x: number, p1y: number, p2x: number, p2y: number) {
    const cx = 3 * p1x;
    const bx = 3 * (p2x - p1x) - cx;
    const ax = 1 - cx - bx;
    const cy = 3 * p1y;
    const by = 3 * (p2y - p1y) - cy;
    const ay = 1 - cy - by;

    const sampleX = (t: number) => ((ax * t + bx) * t + cx) * t;
    const sampleY = (t: number) => ((ay * t + by) * t + cy) * t;
    const sampleDX = (t: number) => (3 * ax * t + 2 * bx) * t + cx;

    // Newton-Raphson: dado x (progreso temporal) encontramos el t de la curva.
    const solveX = (x: number) => {
      let t = x;
      for (let i = 0; i < 8; i++) {
        const dx = sampleX(t) - x;
        const d = sampleDX(t);
        if (Math.abs(dx) < 1e-5 || d === 0) break;
        t -= dx / d;
      }
      return t;
    };

    return (x: number) => sampleY(solveX(x));
  }

  // 👇 Cambiá estos 4 valores por la curva que quieras.
  const ease = cubicBezier(0.91, 0.15, 0.33, 0.99);
  const DURATION = 550; // ms

  function initScroller(section: HTMLElement) {
    const track = section.querySelector<HTMLElement>(".scroller__track");
    const prev = section.querySelector<HTMLButtonElement>(
      ".scroller__arrow--prev",
    );
    const next = section.querySelector<HTMLButtonElement>(
      ".scroller__arrow--next",
    );
    if (!track) return;

    const infinite = section.dataset.infinite === "true";
    // Las cards que vinieron del slot. Todo lo demás en el carril son clones.
    const originals = Array.from(track.children) as HTMLElement[];

    // Ancho de una vuelta completa de la tira original (0 = sin medir).
    let cycle = 0;
    let animating = false;
    let rafId = 0;

    function gapPx() {
      return parseFloat(getComputedStyle(track!).columnGap || "0") || 0;
    }

    function step() {
      const first = track!.firstElementChild as HTMLElement | null;
      if (!first) return track!.clientWidth;
      return first.getBoundingClientRect().width + gapPx();
    }

    /** Ancho de la tira original, gaps incluidos: la distancia de una vuelta. */
    function measureCycle() {
      const gap = gapPx();
      return originals.reduce(
        (w, el) => w + el.getBoundingClientRect().width + gap,
        0,
      );
    }

    /**
     * Las cards no tienen ancho fijo (lo define el ratio de la foto), así que
     * una imagen sin cargar mide 0 y rompe la medición del bucle. En modo
     * infinito las pedimos todas por adelantado y recién ahí clonamos.
     */
    function imagesReady() {
      const imgs = Array.from(track!.querySelectorAll("img"));
      return Promise.all(
        imgs.map((img) => {
          img.loading = "eager";
          if (img.complete && img.naturalWidth > 0) return Promise.resolve();
          return new Promise<void>((resolve) => {
            img.addEventListener("load", () => resolve(), { once: true });
            img.addEventListener("error", () => resolve(), { once: true });
          });
        }),
      );
    }

    /**
     * Clona la tira hasta que el carril mida al menos 3 viewports (y nunca
     * menos de 3 vueltas): así siempre hay contenido a ambos lados y envolver
     * el scroll es invisible.
     */
    function buildLoop() {
      if (!infinite || originals.length === 0) return;

      for (const el of Array.from(track!.children)) {
        if (!originals.includes(el as HTMLElement)) el.remove();
      }

      cycle = measureCycle();
      if (cycle <= 0) return;

      const sets = Math.min(
        12,
        Math.max(3, Math.ceil((track!.clientWidth * 3) / cycle) + 1),
      );

      for (let i = 1; i < sets; i++) {
        for (const el of originals) {
          const clone = el.cloneNode(true) as HTMLElement;
          // El lector de pantalla ya recorrió la tira original.
          clone.setAttribute("aria-hidden", "true");
          clone
            .querySelectorAll("img")
            .forEach((img) => img.setAttribute("loading", "eager"));
          track!.appendChild(clone);
        }
      }

      // Arrancamos en la 2ª vuelta: queda margen para ir hacia atrás.
      track!.scrollLeft = cycle;
    }

    /**
     * Devuelve el scroll a la ventana [cycle, 2·cycle). Como se corrige por
     * exactamente una vuelta, en pantalla no cambia nada.
     */
    function wrap() {
      if (!cycle) return;
      if (track!.scrollLeft >= cycle * 2) track!.scrollLeft -= cycle;
      else if (track!.scrollLeft < cycle) track!.scrollLeft += cycle;
    }

    function animateBy(delta: number) {
      cancelAnimationFrame(rafId);
      const start = track!.scrollLeft;
      const max = track!.scrollWidth - track!.clientWidth;
      // En modo infinito no hay extremos: dejamos pasar y corregimos al final.
      const target = infinite
        ? start + delta
        : Math.max(0, Math.min(start + delta, max));
      const distance = target - start;
      if (distance === 0) return;

      const startTime = performance.now();
      animating = true;
      // Desactivamos el snap durante la animación para que no pelee con
      // el scrollLeft que seteamos frame a frame; lo restauramos al final.
      track!.style.scrollSnapType = "none";

      const frame = (now: number) => {
        const p = Math.min((now - startTime) / DURATION, 1);
        track!.scrollLeft = start + distance * ease(p);
        if (p < 1) {
          rafId = requestAnimationFrame(frame);
        } else {
          animating = false;
          track!.style.scrollSnapType = "";
          wrap();
        }
      };
      rafId = requestAnimationFrame(frame);
    }

    prev?.addEventListener("click", () => animateBy(-step()));
    next?.addEventListener("click", () => animateBy(step()));

    function updateArrows() {
      // Sin extremos que alcanzar, las flechas siempre están habilitadas.
      if (infinite) return;
      const max = track!.scrollWidth - track!.clientWidth - 1;
      if (prev) prev.disabled = track!.scrollLeft <= 0;
      if (next) next.disabled = track!.scrollLeft >= max;
    }

    track.addEventListener(
      "scroll",
      () => {
        // Durante la animación el wrap movería el destino: corregimos al final.
        if (infinite) {
          if (!animating) wrap();
        } else {
          updateArrows();
        }
      },
      { passive: true },
    );

    let resizeId = 0;
    window.addEventListener("resize", () => {
      window.clearTimeout(resizeId);
      resizeId = window.setTimeout(() => {
        buildLoop();
        updateArrows();
      }, 150);
    });

    if (infinite) {
      imagesReady().then(buildLoop);
    } else {
      updateArrows();
    }
  }

  document.querySelectorAll<HTMLElement>(".scroller").forEach(initScroller);
</script>

<style lang="scss">
  .scroller {
    width: 100%;
    box-sizing: border-box;
    padding: 60px 0;

    /* `--gutter` (token global) es la distancia del borde de la página al
       contenido centrado: así el título alinea con el resto de las secciones. */
    .scroller__head {
      padding-inline: var(--gutter);
    }

    .scroller__track {
      display: flex;
      gap: 24px;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      /* La 1ª card arranca alineada con el título; las demás sangran
         hasta el borde derecho de la página (efecto full-bleed). */
      scroll-padding-left: var(--gutter);
      padding: 0 20px 4px var(--gutter);
      scrollbar-width: none;
      -webkit-overflow-scrolling: touch;

      &::-webkit-scrollbar {
        display: none;
      }

      :global(.card) {
        /* Sin ancho fijo: cada card se adapta al ancho de su imagen. */
        flex: 0 0 auto;
        scroll-snap-align: start;
      }
    }

    .scroller__controls {
      // display: none;
      justify-content: flex-end;
      gap: 12px;
      display: flex;
      margin-top: 20px;
      padding-inline: var(--gutter);

      .scroller__arrow {
        width: 46px;
        height: 46px;
        border-radius: 50%;
        // border: 1px solid rgba(0, 0, 0, 0.12);
        border: none;
        background: #ebebeb;
        color: var(--ink-muted);
        font-size: 32px;
        display: flex;
        align-items: center;
        line-height: 1;
        cursor: pointer;
        justify-content: center;
        transition:
          background 0.2s ease,
          border-color 0.2s ease,
          opacity 0.2s ease;

        &:hover:not(:disabled) {
          background: #f3f3f3;
          border-color: rgba(0, 0, 0, 0.25);
        }

        &:disabled {
          opacity: 0.35;
          cursor: default;
        }
      }
    }

    @media screen and (min-width: 768px) {
      .scroller__controls {
        display: flex;
      }
    }
  }

  /* En bucle el snap pelea con la corrección de scroll que hace el wrap
     (y no hay un "principio" al que anclar), así que lo desactivamos. */
  .scroller--infinite .scroller__track {
    scroll-snap-type: none;
    /* La tira no termina: el padding derecho dejaría un hueco al envolver. */
    padding-right: 0;
  }

</style>
