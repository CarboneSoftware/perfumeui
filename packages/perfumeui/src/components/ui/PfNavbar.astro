---
import { ChevronDown, Menu, Moon, Sun, UserRound } from "@lucide/astro";
import PfButton from "./PfButton.astro";
import PfDropdownMenu from "./PfDropdownMenu.astro";

interface ScrollState {
  // number = px, "50vh" = 50% del alto del viewport,
  // "25%" = 25% del rango scrolleable de la página.
  at: number | string;
  // Opcional: hasta dónde el estado sigue activo. Si se omite, activo hasta el
  // final de la página. Útil para "bandas" (ej: dark solo entre 170vh y 280vh).
  until?: number | string;
  add?: string;
  remove?: string;
}

interface NavbarLogo {
  // Logo para el tema claro (tinta oscura sobre fondo claro).
  light: string;
  // Logo para el tema oscuro. Si se omite, se usa `light` en los dos temas.
  dark?: string;
  alt?: string;
}

interface SectionState {
  // Selector CSS del elemento. El estado se aplica mientras la sección esté
  // "cruzando" la línea del nav (top del elemento por encima del nav, bottom
  // por debajo). Preferí esto sobre scrollStates cuando el umbral depende del
  // contenido y no de un valor fijo de vh.
  selector: string;
  add?: string;
  remove?: string;
}

const {
  navItems,
  title,
  backgroundColor,
  maxWidth = "var(--content-max)",
  theme = "light",
  position = "sticky",
  scrollStates = [] as ScrollState[],
  sectionStates = [] as SectionState[],
  // Muestra el switch claro/oscuro. Off por defecto: servaltek.com no lo usa.
  themeToggle = false,
  // Hairline de 1px abajo del nav (--border del tema). Off por defecto: la
  // landing lo usa sobre heroes a sangre, donde la línea sobra.
  borderBottom = false,
  // Logo principal ({ light, dark?, alt? }). Por defecto, el logotipo de Servaltek.
  logo = undefined as NavbarLogo | undefined,
  // Botón de cuenta con el SSO de Servaltek. Con false no se renderiza ni se
  // carga oidc-client-ts.
  auth = true,
} = Astro.props;

// Public cotizador lives in the app (Fase 0 · D1) — a guest quotes without login, no domain change on
// sign-in. PUBLIC_APP_URL ends with a slash; new URL() joins the "cotizar" path safely.
const appUrl = import.meta.env.PUBLIC_APP_URL || "https://app.witlens.studio/";
// La guía puede publicarse bajo un subpath (GUIDE_BASE=/guia): logo y assets van relativos al base.
const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");

const logoLight = logo?.light ?? `${base}res/stek-logotype-light.png`;
const logoDark = logo ? (logo.dark ?? logo.light) : `${base}res/stek-logotype-dark.png`;
const logoAlt = logo?.alt ?? "Logo";
---

<nav
  class:list={[theme, { bordered: borderBottom }]}
  data-wtl-theme={theme}
  style={`position: ${position}; background-color: ${backgroundColor};`}
  data-scroll-states={JSON.stringify(scrollStates)}
  data-section-states={JSON.stringify(sectionStates)}
>
  <div class="content" style={`max-width: ${maxWidth};`}>
    <div class="wrap">
      <a class="logo" href={base}>
        <div class="logotype">
          <img
            class="logo-img logo-img--for-light"
            src={logoLight}
            alt={logoAlt}
          />
          <img
            class="logo-img logo-img--for-dark"
            src={logoDark}
            alt={logoAlt}
          />
          {
          title &&  
          <div class="pipe" />
          <div class="title-nav"> 
          {title} 
          </div>
          }
        </div>
      </a>

      <div class="desktop-nav">
        <div class="desktop-nav-list">
          {
            navItems &&
              navItems.map((item: any) => {
                return (
                  <div class="desktop-nav-item">
                    <a href={item.url}>{item.label}</a>
                    <div class="line" />
                  </div>
                );
              })
          }
        </div>

        <!-- Desborde: en anchos intermedios (tablet, laptop chica) los items
             que no entran en la barra se pasan acá en vez de cortarse. El
             script decide cuáles; sin desborde el wrapper queda oculto. -->
        <div class="nav-more is-hidden">
          <PfDropdownMenu align="end" width="220px" id="nav-more-menu">
            <button
              slot="trigger"
              type="button"
              class="nav-more__btn"
              data-dropdown-trigger
            >
              Más
              <span class="nav-more__chevron"><ChevronDown size={14} /></span>
            </button>

            <div class="nav-more__list">
              {
                navItems &&
                  navItems.map((item: any) => (
                    <a href={item.url} class="is-hidden" role="menuitem">
                      {item.label}
                    </a>
                  ))
              }
            </div>
          </PfDropdownMenu>
        </div>
      </div>
    </div>

    <div class="wrap">
      {
        themeToggle && (
          <button
            type="button"
            class="icon-btn theme-btn"
            aria-label="Activar modo oscuro"
            title="Modo oscuro"
            data-theme-toggle
          >
            <span class="theme-btn__icon theme-btn__icon--moon"><Moon size={20} /></span>
            <span class="theme-btn__icon theme-btn__icon--sun"><Sun size={20} /></span>
          </button>
        )
      }
      {auth && (
      <PfDropdownMenu align="end" width="320px" disabled id="account-menu">
        <a
          slot="trigger"
          class="icon-btn user-btn"
          href={appUrl}
          aria-label="Cuenta"
          data-dropdown-trigger
        >
          <span class="user-btn__icon"><UserRound size={20} /></span>
          <span class="user-btn__initials"></span>
        </a>

        <div class="account">
          <div class="account__top">
            <img
              class="account__brand account__brand--for-light"
              src={logoLight}
              alt=""
              height="16"
            />
            <img
              class="account__brand account__brand--for-dark"
              src={logoDark}
              alt=""
              height="16"
            />
            <!-- <span class="account__brand-name">Witlens</span> -->
            <button type="button" class="account__signout">
              Cerrar sesión
            </button>
          </div>

          <div class="account__body">
            <span class="account__avatar" aria-hidden="true">
              <span class="account__avatar-icon"><UserRound size={30} /></span>
              <span class="account__avatar-initials"></span>
            </span>
            <div class="account__id">
              <p class="account__name"></p>
              <p class="account__email"></p>
              <!-- <a class="account__link" href={appUrl}>Ver cuenta</a> -->
            </div>
          </div>
        </div>
      </PfDropdownMenu>
      )}
      <button
        class="icon-btn menu-btn"
        aria-expanded="false"
        aria-controls="drawer"  
      >
        <Menu size={20} />
      </button>
    </div>
  </div>
</nav>

<!-- Fuera del <nav> a propósito: el nav tiene backdrop-filter y eso lo
     convierte en el contenedor de sus hijos position: fixed, rompiendo el
     posicionamiento del drawer. -->
<aside style={`background-color: ${backgroundColor};`} id="drawer" class:list={["drawer", theme]} data-wtl-theme={theme}>
  <div class="drawer__panel">
    <div class="mobile-nav">
      {
        navItems &&
          navItems.map((item: any) => {
            return <a href={item.url}>{item.label}</a>;
          })
      }
    </div>
  </div>
</aside>
<button
  id="filter"
  class:list={["filter", theme]}
  data-wtl-theme={theme}
  aria-label="Cerrar menú"
  tabindex="-1"></button>

{
  themeToggle && (
    <script is:inline>
      // Corre apenas se parsea el nav, antes del primer pintado: si <html> ya
      // trae el tema guardado (lo pone el script del <head>), el nav, el drawer
      // y el filtro arrancan en ese tema en vez de parpadear en el del prop.
      (() => {
        const t = document.documentElement.dataset.wtlTheme;
        if (t !== "dark" && t !== "light") return;
        const els = [
          document.querySelector("nav[data-scroll-states]"),
          document.getElementById("drawer"),
          document.getElementById("filter"),
        ];
        for (const el of els) {
          if (!el) continue;
          el.classList.toggle("dark", t === "dark");
          el.classList.toggle("light", t === "light");
          el.dataset.wtlTheme = t;
        }
      })();
    </script>
  )
}

<script>
  // Servaltek SSO (Keycloak, vía oidc-client-ts). checkSession prueba primero la
  // sesión guardada en esta pestaña y, si no hay o expiró, un signinSilent
  // (iframe invisible) que levanta una sesión ya iniciada en otra app del realm
  // servaltek. Highlights el ícono de cuenta Y cambia qué hace el click:
  // deslogueado, dispara el login (redirige a auth.servaltek.com y vuelve acá);
  // logueado, abre el menú de cuenta con nombre, mail y "Cerrar sesión". Si algo
  // sale mal acá (cookies de terceros bloqueadas, Keycloak caído) el ícono
  // simplemente queda en su comportamiento deslogueado de siempre — nunca vale
  // la pena mostrar el error en una página pública.
  // Con `auth={false}` el botón no existe y oidc-client-ts ni se descarga: el
  // módulo se importa recién acá.
  const userBtn = document.querySelector<HTMLAnchorElement>(".user-btn");
  const accountMenu = userBtn?.closest<HTMLElement>("[data-dropdown]");
  const initialsEl = document.querySelector<HTMLElement>(".user-btn__initials");
  const avatarInitialsEl = document.querySelector<HTMLElement>(
    ".account__avatar-initials",
  );
  const nameEl = document.querySelector<HTMLElement>(".account__name");
  const emailEl = document.querySelector<HTMLElement>(".account__email");
  const signOutBtn =
    document.querySelector<HTMLButtonElement>(".account__signout");
  let isAuthenticated = false;

  if (userBtn) {
    const auth = import("../../lib/auth");

    userBtn.addEventListener("click", (e) => {
      if (!isAuthenticated) {
        e.preventDefault();
        auth.then(({ login }) => login());
      }
    });

    signOutBtn?.addEventListener("click", () => {
      auth.then(({ logout }) => logout());
    });

    auth.then(({ checkSession }) => checkSession()).then((user) => {
      isAuthenticated = !!user;
      userBtn?.classList.toggle("logged-in", isAuthenticated);

      if (user) {
        const { given_name, family_name, name, preferred_username, email } =
          user.profile;
        const fullName =
          name ?? `${given_name ?? ""} ${family_name ?? ""}`.trim();
        if (fullName) userBtn?.setAttribute("title", fullName);

        // Con sesión el click abre el menú en vez de disparar el login.
        accountMenu?.removeAttribute("data-dropdown-disabled");

        // El menú se llena con lo que haya: si el token no trae nombre queda sólo
        // el mail, y el bloque de identidad no se rompe porque los <p> vacíos no
        // ocupan alto.
        if (nameEl) nameEl.textContent = fullName;
        if (emailEl) emailEl.textContent = email ?? "";

        // Iniciales en vez del icono, en el botón y en el avatar del menú. El
        // fallback al username/email cubre el token sin given_name / family_name;
        // si no sale nada usable no se agrega .has-initials y quedan los iconos,
        // mejor que un botón vacío.
        const initials = (
          `${given_name?.[0] ?? ""}${family_name?.[0] ?? ""}` ||
          (preferred_username?.[0] ?? "") ||
          (email?.[0] ?? "")
        ).toUpperCase();
        if (initials) {
          if (initialsEl) initialsEl.textContent = initials;
          if (avatarInitialsEl) avatarInitialsEl.textContent = initials;
          // La clase va en la raíz del dropdown, que envuelve al trigger y al
          // panel, así el mismo estado destapa las iniciales en los dos lugares.
          accountMenu?.classList.add("has-initials");
        }
      }
    });
  }

  const menuBtn = document.querySelector<HTMLButtonElement>(".menu-btn");
  const nav = document.querySelector<HTMLElement>("nav");
  const aside = document.querySelector<HTMLElement>("aside.drawer");
  const filter = document.querySelector<HTMLElement>("#filter.filter");

  const setDrawer = (open: boolean) => {
    aside?.classList.toggle("opened", open);
    filter?.classList.toggle("opened", open);
    nav?.classList.toggle("opened", open);
    document.body.style.overflow = open ? "hidden" : "";
    menuBtn?.setAttribute("aria-expanded", String(open));
  };


  const closeDrawer = () => setDrawer(false);
  const toggleDrawer = () => setDrawer(!aside?.classList.contains("opened"));

  menuBtn?.addEventListener("click", toggleDrawer);
  // Zona muerta (el backdrop translúcido): cerrar al clickear cualquier parte.
  filter?.addEventListener("click", closeDrawer);
  // Cerrar cuando el usuario clickea un link del drawer (navega o va a un
  // anchor de la misma página). Delegamos para captar futuros links también.
  aside?.addEventListener("click", (e) => {
    const target = e.target as HTMLElement;
    if (target.closest("a")) closeDrawer();
  });
  // Accesibilidad: ESC cierra el drawer si está abierto.
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape" && aside?.classList.contains("opened")) {
      closeDrawer();
    }
  });

  // Desborde de la barra desktop: entre el breakpoint mobile y una pantalla
  // ancha los items pueden no entrar. En vez de cortarlos, los que sobran
  // (de derecha a izquierda) se pasan al menú "Más", manteniendo el orden.
  // No reemplaza al drawer: por debajo de 768px .desktop-nav no se muestra
  // (ancho 0) y esto no hace nada.
  const desktopNav = nav?.querySelector<HTMLElement>(".desktop-nav");
  const barItems = Array.from(
    desktopNav?.querySelectorAll<HTMLElement>(".desktop-nav-item") ?? [],
  );
  const moreWrap = desktopNav?.querySelector<HTMLElement>(".nav-more");
  const moreItems = Array.from(
    moreWrap?.querySelectorAll<HTMLElement>(".nav-more__list a") ?? [],
  );

  if (desktopNav && moreWrap && barItems.length > 0) {
    const fitItems = () => {
      const available = desktopNav.clientWidth;
      if (available === 0) return;

      // Medir con todo visible: los anchos dependen de la fuente cargada,
      // así que no se cachean. Pasa todo en el mismo frame, sin pintar.
      barItems.forEach((el) => el.classList.remove("is-hidden"));
      moreWrap.classList.add("is-hidden");
      const widths = barItems.map((el) => el.offsetWidth);
      const total = widths.reduce((a, b) => a + b, 0);

      let visible = barItems.length;
      if (total > available) {
        moreWrap.classList.remove("is-hidden");
        let room = available - moreWrap.offsetWidth;
        visible = 0;
        while (visible < widths.length && room >= widths[visible]) {
          room -= widths[visible];
          visible++;
        }
      }

      barItems.forEach((el, i) => el.classList.toggle("is-hidden", i >= visible));
      moreItems.forEach((el, i) => el.classList.toggle("is-hidden", i < visible));
      moreWrap.classList.toggle("is-hidden", visible === barItems.length);
    };

    // .desktop-nav toma su ancho del padre (flex: 1, min-width: 0), no de sus
    // hijos, así que ocultar items no realimenta al observer.
    new ResizeObserver(fitItems).observe(desktopNav);
    document.fonts?.ready.then(fitItems);
  }

  // Switch claro/oscuro (solo si se pasó `themeToggle`). El tema vive en
  // <html> (`data-wtl-theme` para los tokens de Servaltek y `data-theme` para
  // Starlight) y se recuerda en localStorage["wtl-theme"].
  const themeBtn = document.querySelector<HTMLButtonElement>("[data-theme-toggle]");

  const applyTheme = (theme: "light" | "dark") => {
    const root = document.documentElement;
    root.dataset.wtlTheme = theme;
    root.dataset.theme = theme;
    for (const el of [nav, aside, filter]) {
      if (!el) continue;
      el.classList.toggle("dark", theme === "dark");
      el.classList.toggle("light", theme === "light");
      el.dataset.wtlTheme = theme;
    }
    themeBtn?.setAttribute(
      "aria-label",
      theme === "dark" ? "Activar modo claro" : "Activar modo oscuro",
    );
    themeBtn?.setAttribute("title", theme === "dark" ? "Modo claro" : "Modo oscuro");
  };

  if (themeBtn) {
    applyTheme(nav?.classList.contains("dark") ? "dark" : "light");
    themeBtn.addEventListener("click", () => {
      const next = nav?.classList.contains("dark") ? "light" : "dark";
      applyTheme(next);
      try {
        localStorage.setItem("wtl-theme", next);
      } catch {}
    });
  }

  // Estados de scroll genéricos: cada { at, add?, remove? } se aplica cuando
  // scrollY > at, y se revierte cuando no. `at` acepta px (number),
  // "Nvh" (relativo al viewport) o "N%" (relativo al rango scrolleable).
  type ScrollState = {
    at: number | string;
    until?: number | string;
    add?: string;
    remove?: string;
  };
  const statesRaw = nav?.dataset.scrollStates;
  let scrollStates: ScrollState[] = [];
  try {
    scrollStates = statesRaw ? (JSON.parse(statesRaw) as ScrollState[]) : [];
  } catch {
    scrollStates = [];
  }

  const resolveAt = (at: number | string): number => {
    if (typeof at === "number") return at;
    const m = /^(-?[\d.]+)(vh|%)$/.exec(at.trim());
    if (!m) return Number(at); // fallback: intenta como número puro
    const val = parseFloat(m[1]);
    if (m[2] === "vh") return (val * window.innerHeight) / 100;
    // "%": porcentaje del rango scrolleable total de la página
    const range = document.documentElement.scrollHeight - window.innerHeight;
    return (val * range) / 100;
  };

  // Targets a los que se propagan las clases. drawer/filter necesitan la
  // misma clase que nav para que las CSS vars de tema flipeen en cascada.
  const targets = [nav, aside, filter].filter(
    (el): el is HTMLElement => el != null,
  );

  // Las clases de arriba flipean el tema, pero el set de tokens compartido se
  // selecciona por atributo (`[data-wtl-theme]`), no por clase. Hay que
  // reespejar el atributo después de cada toggle: si no, la clase cambia y los
  // tokens se quedan clavados en el tema con el que se renderizó el nav.
  const syncTheme = () => {
    for (const el of targets) {
      el.dataset.wtlTheme = el.classList.contains("dark") ? "dark" : "light";
    }
  };

  if (nav && scrollStates.length > 0) {
    const applyScrollStates = () => {
      const y = window.scrollY;
      for (const { at, until, add, remove } of scrollStates) {
        const start = resolveAt(at);
        const end = until != null ? resolveAt(until) : Infinity;
        const active = y > start && y < end;
        for (const el of targets) {
          if (add) el.classList.toggle(add, active);
          if (remove) el.classList.toggle(remove, !active);
        }
      }
      syncTheme();
    };
    window.addEventListener("scroll", applyScrollStates, { passive: true });
    // Re-evaluar al redimensionar: vh y % dependen del tamaño de la ventana
    // / del documento, y el scroll solo no cubre esos cambios.
    window.addEventListener("resize", applyScrollStates, { passive: true });
    applyScrollStates();
  }

  // Estados basados en secciones: activos mientras la sección cruza la línea
  // del nav. Robusto al alto del viewport (a diferencia de scrollStates+vh).
  type SectionState = { selector: string; add?: string; remove?: string };
  const sectionRaw = nav?.dataset.sectionStates;
  let sectionStates: SectionState[] = [];
  try {
    sectionStates = sectionRaw
      ? (JSON.parse(sectionRaw) as SectionState[])
      : [];
  } catch {
    sectionStates = [];
  }

  if (nav && sectionStates.length > 0) {
    const navLine = () => nav.getBoundingClientRect().bottom;

    const applySectionStates = () => {
      const line = navLine();
      for (const { selector, add, remove } of sectionStates) {
        const el = document.querySelector(selector);
        if (!el) continue;
        const rect = el.getBoundingClientRect();
        const active = rect.top <= line && rect.bottom > line;
        for (const target of targets) {
          if (add) target.classList.toggle(add, active);
          if (remove) target.classList.toggle(remove, !active);
        }
      }
      syncTheme();
    };
    window.addEventListener("scroll", applySectionStates, { passive: true });
    window.addEventListener("resize", applySectionStates, { passive: true });
    applySectionStates();
  }
</script>

<style>
  .logotype {
    display: flex;
    align-items: center;
    gap: 10px;

    .title-nav {
      font-family: inherit;
      font-weight: 500;
      font-size: 18px;
    }
  }

  @keyframes fade-in {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  .logo {
    all: unset;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  /* Los dos logos coexisten en el DOM; se muestra uno según la clase de tema
     del nav. Así el swap acompaña sin flash el toggle de scroll. */
  nav .logo-img--for-dark {
    display: none;
  }
  nav.dark .logo-img--for-light {
    display: none;
  }
  nav.dark .logo-img--for-dark {
    display: inline-block;
  }

  /* Tema scopeado (NO global): cada raíz del componente (nav, drawer y filter
     son hermanos) lleva su propio `data-wtl-theme`, que trae el set de tokens
     compartido para ese subárbol. Los nombres locales de abajo son solo alias
     sobre esos tokens — ya no hay valores literales ni un bloque `.dark`. */
  nav,
  .drawer,
  .filter {
    --color: var(--font-color-100);
    --background: var(--gs-100);
    --navbar-color: var(--navbar-bg);
    --traslucid: var(--scrim);
    --color-secondary: var(--font-color-200);
    transition: all 0.2s ease;
  }

  /* Prop `borderBottom`. Con box-sizing: border-box el alto total sigue en
     56px, así que nada que se pegue abajo del nav (top: 56px) se corre. */
  nav.bordered {
    border-bottom: 1px solid var(--border);
  }

  nav {
    color: var(--color);
    background-color: var(--navbar-color);

    width: 100%;
    height: 56px;
    padding-left: 16px;
    padding-right: 8px;
    box-sizing: border-box;
    top: 0;
    left: 0;
    backdrop-filter: saturate(180%) blur(20px);
    z-index: 10;

    .content {
      height: 100%;
      margin: 0 auto;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 16px;
      position: relative;
      z-index: 15;

      .wrap {
        display: flex;
        align-items: center;
        gap: 24px;
        height: 100%;
        /* Los botones de la derecha no ceden ancho: lo que sobra o falta lo
           absorbe la barra de links. */
        flex: none;

        /* El wrap del logo + links ocupa el resto y puede achicarse por debajo
           de su contenido, así .desktop-nav tiene un ancho real que medir. */
        &:first-child {
          flex: 1;
          min-width: 0;
        }

        .logo {
          flex: none;
        }

        .logo-img {
          height: 20px;
        }

        .desktop-nav {
          display: none;
          align-items: center;
          height: 100%;
          flex: 1;
          min-width: 0;

          .desktop-nav-list {
            display: flex;
            align-items: center;
            height: 100%;
            min-width: 0;
            /* Red de seguridad antes de que corra el script: recorta en vez de
               empujar los botones de la derecha. */
            overflow: hidden;
          }

          .desktop-nav-item {
            display: flex;
            flex: none;
            height: 100%;
            flex-direction: column;
            justify-content: center;
            /* align-items: center; */
            padding: 0 14px;
            box-sizing: border-box;
            gap: 5px;
            position: relative;
            white-space: nowrap;

            &.is-hidden {
              display: none;
            }

            a {
              all: unset;
              font-size: 13px;
              font-weight: 400;
              cursor: pointer;
              color: var(--color);
              transition: all 0.3s ease;
            }

            .line {
              width: 0%;
              height: 1px;
              background-color: transparent;
              position: absolute;
              bottom: 10px;
              filter: blur(10px);
              transition: all 0.3s ease;
            }

            &:hover {
