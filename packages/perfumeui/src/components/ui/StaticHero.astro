---
/**
 * Hero de foto fija: la imagen ocupa el ancho y el texto va encima en desktop
 * (`.hero__desktop`) o debajo, sobre fondo blanco, en mobile (`.hero__mobile`).
 */
import type { CtaLink, HeroLogo, ImageSource, Tone } from "../types";
import HeroTextContent from "./HeroTextContent.astro";

interface Props {
  imageSources?: ImageSource[];
  imageFallback: string;
  imageAlt?: string;
  /** Tinta del bloque de texto sobre la foto en desktop. */
  tone?: Tone;
  /**
   * Degradado sobre la foto para que el texto se lea. Solo aparece en desktop,
   * que es donde el texto va encima de la imagen.
   */
  scrim?: boolean;
  badge?: string;
  /**
   * Logo en lugar del badge. En desktop con `tone="light"` (texto sobre foto
   * oscura) usa `srcOnDark` si está; en mobile siempre va sobre blanco.
   */
  logo?: HeroLogo;
  title?: string;
  body?: string;
  cta?: CtaLink;
  secondaryCta?: CtaLink;
  /** Dentro de `HeroCarousel`, solo el primer hero lleva `1`. */
  headingLevel?: 1 | 2;
}

const {
  imageSources = [],
  imageFallback,
  imageAlt = "",
  tone = "light",
  scrim = true,
  ...textProps
} = Astro.props;
---

<section class="hero" aria-label={textProps.title ?? "Introducción"}>
  <picture>
    {imageSources.map((s) => <source srcset={s.srcset} media={s.media} />)}
    <img src={imageFallback} alt={imageAlt} />
  </picture>

  {scrim && <div class:list={["hero__scrim", `hero__scrim--${tone}`]} aria-hidden="true" />}

  <div class="hero__desktop">
    <HeroTextContent {...textProps} tone={tone} />
  </div>

  <div class="hero__mobile">
    <br>
    <div class="hero__mobile-panel">
      <HeroTextContent {...textProps} tone="dark" />
    </div>
  </div>
</section>

<style lang="scss">
  .hero {
    gap: 24px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    position: relative;
    overflow: hidden;

    picture,
    img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: right;
    }

    /* With a fixed height (e.g. inside HeroCarousel) the photo absorbs the
       difference and the mobile text keeps its natural size. */
    picture {
      flex: 1 1 auto;
      min-height: 0;
    }
  }

  /* En mobile el texto va debajo, sobre blanco: ahí el scrim no hace falta. */
  .hero__scrim {
    display: none;
    position: absolute;
    inset: 0;
    z-index: 1;
  }

  .hero__mobile {
    display: block;
  }

  .hero__mobile-panel {
    width: 100%;
    padding: 0 var(--section-px);
    box-sizing: border-box;
    height: fit-content;
    background-color: var(--surface);
    display: flex;
    justify-content: center;
  }

  .hero__desktop {
    display: none;
    max-width: var(--content-max);
    width: 90%;
    position: absolute;
  }

  @media only screen and (min-width: 1085px) {
    .hero {
      display: flex;
      align-items: center;
      // height: 650px;
    }

    .hero__mobile {
      display: none;
    }

    .hero__desktop {
      display: block;
      margin-left: 0;
      z-index: 2;
    }

    .hero__scrim {
      display: block;
    }

    /* Tinta clara: oscurecemos el lado del texto. */
    .hero__scrim--light {
      // background: linear-gradient(
      //   90deg,
      //   rgba(0, 0, 0, 0.7) 0%,
      //   rgba(0, 0, 0, 0.35) 45%,
      //   rgba(0, 0, 0, 0) 80%
      // );
    }

    /* Tinta oscura: lo aclaramos, mismo criterio al revés. */
    .hero__scrim--dark {
      // background: linear-gradient(
      //   90deg,
      //   rgba(255, 255, 255, 0.8) 0%,
      //   rgba(255, 255, 255, 0.45) 45%,
      //   rgba(255, 255, 255, 0) 80%
      // );
    }
  }

</style>
